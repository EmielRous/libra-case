generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  key          Int     @id @default(autoincrement())
  task         String
  completed    Boolean @default(false)
  isConcept    Boolean @default(false)
  todoKey      Int?
  parentTodoId Int?
  parentTodo   Todo?   @relation("Subtodos", fields: [parentTodoId], references: [key])
  subtodos     Todo[]  @relation("Subtodos")
}
